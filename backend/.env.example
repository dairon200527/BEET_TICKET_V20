# Copy this file to `.env` and fill in REAL values. Never commit `.env`.
# Every value below is a placeholder — nothing here is a working credential.

# --- Database ------------------------------------------------------------
# Your real PostgreSQL instance, with the 11 existing tables restored
# from beet_ticket.backup. Replace <PASSWORD> with your actual postgres
# password (and the host/db name if different from the defaults below).
DATABASE_URL=postgresql+psycopg2://postgres:<PASSWORD>@localhost:5432/beet_ticket

# --- JWT / sessions --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS --------------------------------------------------------------------
# Comma-separated list of exact allowed origins. Never "*" in production.
CORS_ORIGINS=http://localhost:5173

# --- Environment ---------------------------------------------------------
# "development" or "production". Refuses to start with permissive CORS,
# a default JWT secret, or a default DATABASE_URL in production.
ENVIRONMENT=development

# --- Out of scope this pass (ADMIN MODULE integration) ---------------------
# Firebase Storage, file retention, and password-recovery email delivery
# are NOT wired up in this integration pass (see ../README.md and
# ../SCHEMA_NOTES.md for what's intentionally not implemented yet). No
# related environment variables are read by the application right now.
